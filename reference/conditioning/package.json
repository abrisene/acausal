{
  "name": "@acausal/conditioning",
  "version": "0.1.0",
  "description": "Bounded exact conditioning and deterministic sampling over authored finite categorical models",
  "author": "David Robinson",
  "license": "Apache-2.0",
  "homepage": "https://github.com/abrisene/acausal/tree/main/packages/conditioning",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrisene/acausal.git",
    "directory": "packages/conditioning"
  },
  "bugs": {
    "url": "https://github.com/abrisene/acausal/issues"
  },
  "keywords": [
    "probability",
    "conditioning",
    "factor-graph",
    "exact-inference",
    "procedural-generation",
    "deterministic"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acausal/random": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
