{
  "name": "@acausal/distributions",
  "version": "3.0.0-alpha.3",
  "description": "Weighted random selection from discrete distributions — type-safe, serializable, with immutable and mutable APIs",
  "author": "David Robinson",
  "license": "Apache-2.0",
  "homepage": "https://github.com/abrisene/acausal/tree/main/packages/distributions",
  "repository": { "type": "git", "url": "git+https://github.com/abrisene/acausal.git", "directory": "packages/distributions" },
  "bugs": { "url": "https://github.com/abrisene/acausal/issues" },
  "keywords": ["distribution", "weighted-random", "probability", "immutable", "serializable", "procedural-generation"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acausal/random": "workspace:*",
    "@acausal/scalr": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.6.3"
  }
}
