{
  "name": "@acausal/scalr",
  "version": "1.1.4",
  "description": "Lightweight scaling and normalization utilities for weighted objects and arrays",
  "author": "David Robinson",
  "license": "Apache-2.0",
  "homepage": "https://github.com/abrisene/acausal/tree/main/packages/scalr",
  "repository": { "type": "git", "url": "git+https://github.com/abrisene/acausal.git", "directory": "packages/scalr" },
  "bugs": { "url": "https://github.com/abrisene/acausal/issues" },
  "keywords": ["scaling", "scale", "normalize", "normalization", "statistics", "weighted", "array", "object"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.6.3"
  }
}
