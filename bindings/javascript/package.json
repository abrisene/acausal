  "description": "Rust-backed seeded generation, weighted choices, Markov models, and finite conditioning",
  "type": "module",
  "license": "Apache-2.0",
  "author": "David Robinson",
  "homepage": "https://github.com/abrisene/acausal",
  "repository": {
