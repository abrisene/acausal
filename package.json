{
  "name": "acausal-monorepo",
  "private": true,
  "description": "Procedural generation toolkit — seeded RNG, weighted distributions, Markov chains, statistical sampling",
  "author": "David Robinson <dr@monetise.io>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.11.0",
  "type": "module",
  "scripts": {
    "build": "pnpm nx run-many --target=build --all",
    "test": "pnpm nx run-many --target=test --all",
    "typecheck": "pnpm nx run-many --target=typecheck --all",
    "dev": "pnpm nx run-many --target=dev --all",
    "lint": "gts lint",
    "lint:fix": "gts fix",
    "docs": "pnpm --dir web run build",
    "docs:dev": "pnpm --dir web run dev",
    "clean": "rm -rf packages/*/dist coverage .site web/dist web/.astro",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "^3.0.0",
    "gts": "^5.3.1",
    "nx": "^22.6.1",
    "tsup": "^8.2.4",
    "typedoc": "^0.26.6",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
