{
  "name": "acausal",
  "version": "3.0.0-alpha.1",
  "description": "Markov Chain and Random Distribution Toolset",
  "author": "David Robinson <dr@monetise.io> (http://www.monetise.io)",
  "homepage": "https://github.com/abrisene/acausal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrisene/acausal.git"
  },
  "bugs": {
    "url": "https://github.com/abrisene/acausal/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "markov",
    "markov chain",
    "markov-chain",
    "random",
    "stochastic",
    "distribution",
    "random distribution",
    "name generator",
    "procedural generation"
  ],
  "packageManager": "pnpm@10.11.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "gts lint",
    "lint:fix": "gts fix",
    "docs": "typedoc",
    "clean": "rm -rf dist lib coverage .site",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build"
  },
  "dependencies": {
    "scalr": "1.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "^3.0.0",
    "gts": "^5.3.1",
    "tsup": "^8.2.4",
    "typedoc": "^0.26.6",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
