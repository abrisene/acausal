{
  "name": "acausal",
  "version": "3.2.0",
  "description": "Markov Chain and Random Distribution Toolset",
  "author": "David Robinson <dr@monetise.io> (http://www.monetise.io)",
  "homepage": "https://github.com/abrisene/acausal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrisene/acausal.git"
  },
  "bugs": {
    "url": "https://github.com/abrisene/acausal/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "markov",
    "markov chain",
    "markov-chain",
    "random",
    "stochastic",
    "distribution",
    "random distribution",
    "name generator",
    "procedural generation"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "gts lint",
    "lint:fix": "gts fix",
    "docs": "typedoc",
    "clean": "rm -rf dist lib coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "preversion": "npm test",
    "postversion": "npm run docs"
  },
  "dependencies": {
    "random-js": "2.1.0",
    "scalr": "1.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "coveralls": "^3.1.1",
    "gts": "^5.3.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.2.4",
    "typedoc": "^0.26.6",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
